# ==============================================================================
# RIETI BACKEND - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS MYSQL (asyncmy)
# ------------------------------------------------------------------------------
# Host o IP del servidor MySQL (ej. localhost o endpoint de AWS RDS)
MYSQL_DB_HOST=localhost

# Puerto de escucha del motor MySQL (puerto estándar: 3306)
MYSQL_DB_PORT=3306

# Nombre de la base de datos relacional del proyecto
MYSQL_DB_NAME=rieti_db

# Usuario con privilegios de lectura y escritura en la base de datos
MYSQL_DB_USER=rieti_user

# Contraseña de autenticación del usuario de MySQL
MYSQL_DB_PASSWORD=tu_contrasena_segura_aqui

# ------------------------------------------------------------------------------
# 2. AUTENTICACIÓN FEDERADA Y SEGURIDAD (AWS COGNITO)
# ------------------------------------------------------------------------------
# Región de AWS donde reside el User Pool de Cognito (ej. us-east-1, us-west-2)
AWS_COGNITO_REGION=us-east-1

# Identificador alfanumérico único del User Pool de AWS Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx

# App Client ID configurado en Cognito para la aplicación móvil Android / frontend
ANDROID_APP_CLIENT_ID=tu_android_app_client_id_aqui